# Salin file ini ke .env dan isi nilainya
# JANGAN commit file .env ke git

# Secret key untuk JWT — generate dengan: openssl rand -hex 32
SECRET_KEY=ganti_dengan_string_random_panjang

# Algoritma JWT
ALGORITHM=HS256

# Berapa menit token berlaku
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Kunci untuk membaca rekap kuesioner
ADMIN_KEY=ganti_dengan_kunci_admin

# URL database (SQLite untuk dev)
DATABASE_URL=sqlite:///./furai.db

# Domain frontend yang diizinkan CORS (pisah koma kalau lebih dari satu)
ALLOWED_ORIGINS=http://localhost:3000,https://furai-green.vercel.app
